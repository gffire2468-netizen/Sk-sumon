# ==============================================================================
# SKX MINING — REQUIRED CORE ENVIRONMENT SECRETS
# Only these 6 variables are required for normal / demo mode startup.
# All other business settings, rates, and integrations have built-in safe defaults
# and are purely optional.
# ==============================================================================

TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
TELEGRAM_WEBHOOK_SECRET="MY_TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_BOT_USERNAME="SKXMiningBot"

ADMIN_JWT_SECRET="MY_ADMIN_JWT_SECRET"
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="MY_ADMIN_PASSWORD"

# ==============================================================================
# OPTIONAL RUNTIME & BUSINESS SETTINGS (DO NOT REQUIRE USER INPUT)
# Defaults are already embedded in the application code.
# ==============================================================================
# PORT=3000
# NODE_ENV=development
# DEMO_MODE=true
# APP_BASE_URL=http://localhost:3000
# DAILY_REWARD_MODE=DAILY_BONUS
# DAILY_REWARD_BASE_REWARD=0.01

# ==============================================================================
# OPTIONAL DATABASE & CACHING (Only needed if DEMO_MODE=false)
# ==============================================================================
# DATABASE_URL=postgres://user:password@localhost:5432/skx_mining
# REDIS_URL=redis://localhost:6379

# ==============================================================================
# OPTIONAL INTEGRATION CREDENTIALS (Only needed if respective ENABLED=true)
# ==============================================================================
# BKASH_ENABLED=false
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=

# NAGAD_ENABLED=false
# NAGAD_BASE_URL=https://api.mynagad.com
# NAGAD_MERCHANT_ID=
# NAGAD_MERCHANT_KEY=

# ROCKET_ENABLED=false
# ROCKET_BASE_URL=https://rocket.dutchbanglabank.com/api
# ROCKET_API_KEY=
# ROCKET_SECRET=

# COMMUNITY_REWARD_ENABLED=false
# COMMUNITY_CHAT_ID=
# COMMUNITY_INVITE_LINK=https://t.me/SKXMiningCommunity
# COMMUNITY_REWARD=0.1

# ADS_ENABLED=false
# MONETAG_ENABLED=false
# MONETAG_AD_TAG=
# ADSTERRA_ENABLED=false
# ADSTERRA_ZONE_ID=
# GENERIC_AD_ENABLED=false
# GENERIC_AD_TAG=
